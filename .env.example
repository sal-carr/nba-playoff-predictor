# Outerbounds / Metaflow cloud configuration
# Leave blank for local-only execution
OUTERBOUNDS_PROFILE=
METAFLOW_PROFILE=
METAFLOW_DEFAULT_METADATA=
METAFLOW_SERVICE_URL=
METAFLOW_METADATA_SERVICE_URL=

# AWS configuration (if using S3-backed Metaflow)
AWS_PROFILE=
AWS_DEFAULT_REGION=

# Python path for local imports
PYTHONPATH=

# Instructions:
# 1. Copy this file to .env
# 2. Fill in values if you have Outerbounds/cloud credentials
# 3. If no cloud credentials, run locally first - do not block the project
# 4. Leave a deployment handoff document if Outerbounds cannot be completed
